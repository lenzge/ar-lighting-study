#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Xform "Root"
    {
        reorder nameChildren = ["Metallic", "Matt", "Glossy", "Emissive", "Glas", "Sphere", "Dino"]
        rel material:binding = None (
            bindMaterialAs = "weakerThanDescendants"
        )
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Sphere "Sphere" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            reorder nameChildren = ["Collider", "InputTarget", "GridMaterial"]
            rel material:binding = </Root/Root/Metallic/Material> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double radius = 0.1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def RealityKitComponent "Collider"
            {
                uint group = 1
                uniform token info:id = "RealityKit.Collider"
                uint mask = 4294967295
                token type = "Default"

                def RealityKitStruct "Shape"
                {
                    float3 extent = (0.2, 0.2, 0.2)
                    float radius = 0.1
                    token shapeType = "Sphere"
                }
            }

            def RealityKitComponent "InputTarget"
            {
                uniform token info:id = "RealityKit.InputTarget"
            }
        }

        def "Metallic" (
            active = true
            references = @Materials/Metallic.usda@
        )
        {
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Material"
            {
                over "PreviewSurface"
                {
                    color3f inputs:diffuseColor = (0.5066016, 0.5066016, 0.5066016) (
                        colorSpace = "srgb_displayp3"
                    )
                    float inputs:metallic = 0.9
                    float inputs:roughness = 0.1
                    int ui:nodegraph:node:stackingOrder = 21
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
                }
            }
        }

        def "Matt" (
            active = true
            references = @Materials/Metallic.usda@
        )
        {
            float2 ui:nodegraph:node:pos = (215.875, 104.5)
            int ui:nodegraph:node:stackingOrder = 1
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Material"
            {
                over "PreviewSurface"
                {
                    color3f inputs:diffuseColor = (0.7783203, 0.5440858, 0.18641697) (
                        colorSpace = "srgb_displayp3"
                    )
                    float inputs:metallic = 0
                    float inputs:roughness = 0.9
                    int ui:nodegraph:node:stackingOrder = 26
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
                }
            }
        }

        def "Glossy" (
            active = true
            references = @Materials/Metallic.usda@
        )
        {
            float2 ui:nodegraph:node:pos = (235.875, 124.5)
            int ui:nodegraph:node:stackingOrder = 2
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Material"
            {
                over "PreviewSurface"
                {
                    color3f inputs:diffuseColor = (0.7783203, 0.5440858, 0.18641697) (
                        colorSpace = "srgb_displayp3"
                    )
                    float inputs:metallic = 0
                    float inputs:roughness = 0.1
                    int ui:nodegraph:node:stackingOrder = 31
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
                }
            }
        }

        def "Emissive" (
            active = true
            references = @Materials/Metallic.usda@
        )
        {
            float2 ui:nodegraph:node:pos = (255.875, 144.5)
            int ui:nodegraph:node:stackingOrder = 3
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Material"
            {
                over "PreviewSurface"
                {
                    color3f inputs:diffuseColor = (0.24819621, 0.7783203, 0.22955047) (
                        colorSpace = "srgb_displayp3"
                    )
                    color3f inputs:emissiveColor = (0.21588416, 0.9170312, 0.2725466) (
                        colorSpace = "srgb_displayp3"
                    )
                    float inputs:metallic = 0
                    float inputs:roughness = 0.1
                    int ui:nodegraph:node:stackingOrder = 39
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced", "inputs:emissiveColor"]
                }
            }
        }

        def "Glas" (
            active = true
            references = @Materials/Metallic.usda@
        )
        {
            float2 ui:nodegraph:node:pos = (275.875, 164.5)
            int ui:nodegraph:node:stackingOrder = 4
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Material"
            {
                over "PreviewSurface"
                {
                    color3f inputs:diffuseColor = (1, 0.98988575, 0.9909745) (
                        colorSpace = "srgb_displayp3"
                    )
                    color3f inputs:emissiveColor = (0.97751975, 1, 0.98370326) (
                        colorSpace = "srgb_displayp3"
                    )
                    float inputs:metallic = 0
                    float inputs:opacity = 0.1
                    float inputs:roughness = 0
                    int ui:nodegraph:node:stackingOrder = 46
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced", "inputs:emissiveColor"]
                }
            }
        }
    }
}

